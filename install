#!/usr/bin/env bash
# install — dotbot dispatcher. Common links + per-platform links.
# Platforms: install-darwin.yaml (macOS), install-linux.yaml (Linux/omarchy).

set -e

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"
git submodule update --init --recursive "${DOTBOT_DIR}"

case "$(uname -s)" in
  Darwin) PLATFORM="darwin" ;;
  Linux)  PLATFORM="linux"  ;;
  *) echo "Unsupported platform: $(uname -s)" >&2; exit 1 ;;
esac

CONFIGS=("install.conf.yaml")
[[ -f "install-${PLATFORM}.yaml" ]] && CONFIGS+=("install-${PLATFORM}.yaml")

# One dotbot invocation PER config: this vendored dotbot (v1.19+22) keeps only
# the last -c file (argparse overwrite); multi-config merge needs a newer build.
for config in "${CONFIGS[@]}"; do
  "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${config}" "${@}"
done
