#!/bin/sh
# clipcopy — platform-agnostic clipboard sink for tmux/fzf bindings.
# Reads stdin and writes to: pbcopy (Darwin) / wl-copy (Wayland, Linux) /
# xclip -selection clipboard (X11, fallback). Silent no-op when nothing matches.

if [ "$(uname -s)" = "Darwin" ]; then
  exec pbcopy
elif command -v wl-copy >/dev/null 2>&1; then
  exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard
fi
exit 0