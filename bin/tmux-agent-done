#!/usr/bin/env bash
# tmux-agent-done - desktop notification when a long command finishes in a
# tmux pane you are not looking at. The monitor-hook path: tmux calls this
# when a pane falls idle again.
#
# The shell-driven path (packages/sh/zshrc preexec/precmd hooks) calls
# bin/tmux-agent-notify directly and works on every tmux version — tmux 3.8
# accepts monitor hooks but never fires them, so this sweep alone left the
# finisher dormant on stable tmux. Both paths share the pane state
# (@busy-since-<pane> / @busy-cmd-<pane>) and the notification core, and the
# core only reports a run whose state is still pending, so a long command is
# never announced twice.
#
# Usage: tmux-agent-done
#   No arguments: the @agent-done hook fires per pane with no payload, so the
#   panes to consider are found by scanning for a recorded @busy-since-* that
#   is now idle. The previous signature (<pane-id> [socket-path]) relied on
#   #{pane_id} interpolated into a nested quoted run-shell, which never ran.
# Tunables (tmux options):
#   @agentic-notify-secs  minimum runtime to notify (default 30)

set -u

sock=""
if [ -n "${TMUX:-}" ]; then
    sock="${TMUX%%,*}"
fi
t() { tmux ${sock:+-S "$sock"} "$@"; }

min=$(t show -gv @agentic-notify-secs 2>/dev/null)
min=${min:-30}
now=$(date +%s)

for pane in $(t list-panes -a -F '#{pane_id}'); do
    since=$(t show -pqv -t "$pane" "@busy-since-$pane" 2>/dev/null)
    cmd=$(t show -pqv -t "$pane" "@busy-cmd-$pane" 2>/dev/null)
    [ -n "$since" ] || continue
    [ -n "$cmd" ] || continue

    # Only panes that are idle NOW are finished runs. A pane that is still
    # busy keeps its state: clearing it here would report a running command
    # as finished and lose its start time.
    running=$(t display -p -t "$pane" '#{pane_current_command}' 2>/dev/null)
    case "$running" in
        zsh|bash|sh|fish) ;;
        *) continue ;;
    esac

    elapsed=$((now - since))
    [ "$elapsed" -ge "$min" ] || continue

    # The core does the interactive-app skip list, the "user is looking at
    # this pane" check, clears the state and sends the notification.
    "$HOME/.dotfiles/bin/tmux-agent-notify" "$pane" "$cmd" "$elapsed"
done
