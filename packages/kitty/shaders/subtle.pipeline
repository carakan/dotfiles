# subtle.pipeline — cheap, event-gated visual effects for this dotfiles setup.
#
# Loaded via `custom_shaders subtle` in kitty.conf. Kept to shaders that do
# NOT redraw the screen on a timer: the dim pass is static (animation_step 0,
# it only repaints when content or the active window changes) and the trail
# pass only runs while the cursor is actually moving. That is what makes these
# effects free on an idle terminal.
#
# Deliberately NOT enabled: inside-the-matrix / northern-lights / fireworks /
# water / underwater / crt / crt-blue / tft / spotlight. All of those either
# animate continuously (a full-viewport GPU pass every frame, forever) or loop
# a ray-march per pixel; they are the ones that make a terminal feel laggy.

# ── Pass 1: dim inactive panes toward gray (same shader as dim-inactive-
# windows, retuned). Static: no periodic frames, repaint only on change.
startgroup
    animation_step 0
    # 0 = no brightness boost on the active window, 0 border glow.
    var float HIGHLIGHT_INTENSITY = 0
    var float BORDER_WIDTH = 0
    # Fraction of the original color kept in inactive panes; 0.72 blends in
    # 28% of the target color. 0.3 (shipped default) crushes a #1e1e1e
    # background to near black and makes agent output unreadable.
    var float INACTIVE_DIM = 0.72
    # Gray #808080 in linear RGB, instead of the shipped pure-black target.
    var float3 INACTIVE_DIM_COLOR = float3(0.2158605)
    # Leave the tab bar alone and treat the active window's padding/margin/
    # border as part of it, so the focused pane is not framed by a dim band.
    var bool DIM_CENTRAL_AREA_ONLY = true
    var bool INCLUDE_WINDOW_PADDING = true
    shaders focus-highlight
endgroup

# ── Pass 2: motion-blurred cursor trail. Requires `cursor_trail` to be set
# in kitty.conf. Subscribing to cursor-trail-move hands rendering to this
# shader and switches kitty's built-in trail off. Pixels outside the area the
# trail swept this frame return early, so the cost is bounded by the trail,
# not by the window size.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    # 8 of the shader's 1..64 range: still glides instead of hopping, at half
    # the per-pixel cost of the shipped 16.
    var int MOTION_BLUR_SAMPLES = 8
    shaders cursor-trail-motion-blur
endgroup
