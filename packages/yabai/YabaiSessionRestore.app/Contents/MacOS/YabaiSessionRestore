#!/bin/sh
# YabaiSessionRestore — launcher for com.carakan.yabai-session.plist.
#
# The launchd job used to run "/bin/sh session_restore.sh", and macOS took the
# Login Items name from the executable it launched: the row read "sh", with no
# description and no developer. Launching this bundle instead gives the row a
# proper name ("Yabai Session Restore") and the yabai icon.
#
# The actual work still lives in the repo's session_restore.sh; this file only
# forwards to it.
set -e

exec "$(dirname "$0")/../../../session_restore.sh" "$@"
