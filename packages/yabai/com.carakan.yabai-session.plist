<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.carakan.yabai-session.plist — applies the saved yabai workspace
  session once at login, after com.asmvik.yabai is serving the socket.

  It is a one-shot (RunAtLoad, no KeepAlive): it waits for the yabai
  socket, waits for post-login windows to settle, then runs
  `yabai -m space` with the load-session flag. Its own progress goes to
  ~/.local/state/yabai/restore.log; the paths below only capture launchd's
  view of the script (e.g. "permission denied" from a bad interpreter).

  It launches YabaiSessionRestore.app (a bundle in this repo) instead of
  "/bin/sh session_restore.sh": macOS names the Login Items row after the
  launched executable, so running /bin/sh made the row read "sh" with no
  description. The bundle's launcher forwards to the same script.

  Exit code 1 means the yabai socket never appeared — in practice that
  means yabai itself failed to start, so read com.asmvik.yabai's log first.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carakan.yabai-session</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/carakan/.dotfiles/packages/yabai/YabaiSessionRestore.app/Contents/MacOS/Yabai Session Restore</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/carakan/.local/state/yabai/session-restore.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/carakan/.local/state/yabai/session-restore.err.log</string>
</dict>
</plist>