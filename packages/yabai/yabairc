#!/usr/bin/env sh
# The scripting addition has to be loaded as root ("scripting-addition must
# be loaded as root!"). Without it yabai delivers NO window events at all
# (window_created / window_focused / application_* never fire), so the
# border script below never runs and the border colors stay frozen at the
# values set at the bottom of this file.
#
# `sudo` cannot prompt here: this file is sourced by launchd at login and
# signal actions run without a terminal. /etc/sudoers.d/yabai therefore has
# to grant NOPASSWD for exactly this command. If sudo answers "a password
# is required", that rule is missing or does not match the command — fix it
# with:
#   printf 'carakan ALL=(root) NOPASSWD: /usr/local/bin/yabai --load-sa\n' \
#     | sudo tee /etc/sudoers.d/yabai
sudo /usr/local/bin/yabai --load-sa
yabai -m signal --remove dock_did_restart 2>/dev/null
yabai -m signal --add event=dock_did_restart \
    action="sudo /usr/local/bin/yabai --load-sa" label=dock_did_restart

# SPACES
# Guarded so a normal login writes nothing into yabai.err.log. Unguarded, the
# label of a space this display setup does not have logged "could not locate
# the space to act on!", and the display assignment logged "acting space is
# already located on the given display." (exit 1, plus "mission-control is
# active" while the login animation runs) on every single login.
nspaces=$(yabai -m query --spaces 2>/dev/null | jq 'length' 2>/dev/null)
case "$nspaces" in ''|*[!0-9]*) nspaces=9 ;; esac

space_label() {  # space_label <index> <label>
    [ "$1" -le "$nspaces" ] && yabai -m space "$1" --label "$2"
}
space_label 1 1_work
space_label 2 2_webs
space_label 3 3_email
space_label 4 4_code
space_label 5 5_temp
space_label 6 6_temp
space_label 7 7_temp
space_label 8 8_temp
space_label 9 9_other

yabai -m config --space 5_temp layout float
yabai -m config --space 6_temp layout float
yabai -m config --space 7_temp layout float

ndisplays=$(yabai -m query --displays 2>/dev/null | jq 'length' 2>/dev/null)
case "$ndisplays" in ''|*[!0-9]*) ndisplays=2 ;; esac

space_to_display() {  # space_to_display <label> <display> — only on a real change
    [ "$2" -le "$ndisplays" ] || return 0
    cur=$(yabai -m query --spaces --space "$1" 2>/dev/null | jq -r '.display' 2>/dev/null)
    [ "$cur" = "$2" ] || yabai -m space "$1" --display "$2"
}
space_to_display 1_work 1
space_to_display 2_webs 1
space_to_display 3_email 1
space_to_display 4_code 1
space_to_display 5_temp 1
space_to_display 6_temp 1
space_to_display 7_temp 1
space_to_display 8_temp 2

#======= Rules =======================
yabai -m rule --add app="^(Proton Mail|Spark|Outlook|Outlook \(PWA\))$" space=1_work
yabai -m rule --add app="^(Microsoft Edge|Safari|Google Chrome)$" space=2_webs
yabai -m rule --add app="^(kitty)$" space=3_email
yabai -m rule --add app="^(Code)$" space=4_code
yabai -m rule --add app="^(TagGUI|VisoMaster Fusion|python|Topaz Video AI|Lightroom Classic|HitPaw Photo AI|Adobe Photoshop 2025|Topaz Photo AI|Python)$" space=5_temp
yabai -m rule --add app="^(ToshLLM|Trezor Suite|Obsidian|Bitwarden|FileZilla|Insomnia|Firefox Developer Edition|Boom 3D|Maps|Gemini 2|UserNotificationCenter|1Password 7|Creative Cloud|Docker Desktop|Preview|System Settings|Podcasts|CleanMyMac X|Navicat Premium|App Store|Dash|Activity Monitor|Calculator|Finder|Notes|Invoice Pro|Fork|Books|IINA|VLC|Microsoft Excel|Microsoft Word|Font Book)$" space=6_temp
yabai -m rule --add app="^(Tailscale|OpenVPN Connect|OpenVPN|Slack|Zoom|Discord|Skype|WhatsApp)$" space=7_temp
yabai -m rule --add app="^(Firefox|X|Spotify)$" space=8_temp

# ignore these apps
yabai -m rule --add app=".*" sub-layer=normal
# Picture-in-Picture: never insert into the tree at all (pre-insert float,
# no layout reshuffle)
yabai -m rule --add app="^Picture-in-Picture$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Little Snitch$" manage=off
yabai -m rule --add app="^About This Mac" manage=off
yabai -m rule --add app="^Activity Monitor" manage=off
yabai -m rule --add app="^Calendar" manage=off
yabai -m rule --add app="^Calculator" manage=off
yabai -m rule --add app="^Clock" manage=off
yabai -m rule --add app="^Contacts" manage=off
yabai -m rule --add app="^Alfred Preferences$" manage=off
yabai -m rule --add app="^zoom.us" manage=off
# firefox PIP
#yabai -m rule --add app="^Firefox$" title="^$" manage=off layer=below

# Do not manage windows with certain titles eg. Copying files or moving to bin
yabai -m rule --add title="(Copy|Bin|About This Mac|Info)" manage=off
yabai -m rule --apply

#======= Global Config =======================
# Three options that only exist in the fork since v7.1.33 / v7.1.35 / v7.3.0
# (they are absent from every upstream yabai release):
#   window_native_tabs             — native macOS tabs (Terminal, Finder,
#     Ghostty) share one tile, so opening/switching/closing a tab no longer
#     reshuffles the BSP layout. Only the selected tab is in the layout; a tab
#     dragged out of the tab bar becomes its own tile. Off upstream by default.
#   mouse_bsp_live_resize          — resizing a tiled window with the mouse
#     moves the sibling borders live instead of only on mouse release. The
#     fork's default is 'on'; pinned here so the behaviour does not change
#     silently when the fork flips a default again.
#   space_gesture_natural_scrolling — direction of the synthesized swipe used
#     for space switching without the scripting addition. 'auto' follows the
#     macOS "Natural scrolling" system preference. A no-op with the SA
#     loaded (the SA switches spaces directly), pinned so a future
#     `csrutil enable` does not invert the swipe direction silently.
yabai -m config                              \
    window_native_tabs           on           \
    mouse_bsp_live_resize        on           \
    space_gesture_natural_scrolling auto      \
    external_bar                off:41:0     \
    menubar_opacity             1.0          \
    mouse_follows_focus         off          \
    focus_follows_mouse         off          \
    display_arrangement_order   default      \
    window_origin_display       default      \
    window_placement            second_child \
    window_insertion_point      focused      \
    window_zoom_persist         on           \
    window_shadow               on           \
    window_animation_duration   0.0          \
    window_animation_easing     ease_in_out_quint \
    window_opacity_duration     0.0          \
    active_window_opacity       1.0          \
    normal_window_opacity       0.91         \
    window_opacity              on           \
    insert_feedback_color       0xaad75f5f   \
    split_ratio                 0.50         \
    split_type                  auto         \
    auto_balance                off          \
    top_padding                 2            \
    bottom_padding              2            \
    left_padding                2            \
    right_padding               2            \
    window_gap                  2            \
    layout                      bsp          \
    mouse_modifier              fn           \
    mouse_action1               move         \
    mouse_action2               resize       \
    mouse_drop_action           swap

#======= Border color by real occupancy (no geometry changes) ==========
# update_border_color.sh hides the border when the space has exactly 1
# VISIBLE managed window (hidden helper windows make the raw count useless),
# and shows it otherwise. Pure borders IPC -> no resizes, no kitty/tmux
# flicker. Labels are unique per event and removed before adding so
# re-running yabairc stays clean.
BORDER_SCRIPT="/Users/carakan/.dotfiles/packages/yabai/update_border_color.sh"
add_border_signal() {
    yabai -m signal --remove "label=border_$1" 2>/dev/null
    yabai -m signal --add event="$1" action="${BORDER_SCRIPT}" "label=border_$1"
}
for event in window_created window_destroyed window_focused space_changed; do
    add_border_signal "$event"
done

# Launch the borders daemon with defaults, then set the correct color now
borders width=3.0 hidpi=off inactive_color=0x00000000 active_color=0xffcccccc &
"${BORDER_SCRIPT}"

echo "yabai configuration loaded.."
