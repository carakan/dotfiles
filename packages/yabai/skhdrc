# ==============================================================================
# skhd — yabai keyboard shortcuts
# ==============================================================================
# Modifiers: alt=option, cmd=command, ctrl=control, shift=shift
# All shortcuts are GLOBAL (system-wide). skhd must be running.

# ------------------------------------------------------------------------------
# Window Navigation (focus)
# ------------------------------------------------------------------------------
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# ------------------------------------------------------------------------------
# Window Warp (move window into another container)
# ------------------------------------------------------------------------------
shift + alt - h : yabai -m window --warp west
shift + alt - j : yabai -m window --warp south
shift + alt - k : yabai -m window --warp north
shift + alt - l : yabai -m window --warp east

# ------------------------------------------------------------------------------
# Move window to space (send)
# ------------------------------------------------------------------------------
shift + alt - 1 : yabai -m window --space 1
shift + alt - 2 : yabai -m window --space 2
shift + alt - 3 : yabai -m window --space 3
shift + alt - 4 : yabai -m window --space 4
shift + alt - 5 : yabai -m window --space 5
shift + alt - 6 : yabai -m window --space 6
shift + alt - 7 : yabai -m window --space 7
shift + alt - 8 : yabai -m window --space 8
shift + alt - 9 : yabai -m window --space 9

# ------------------------------------------------------------------------------
# Focus space (change desktop)
# ------------------------------------------------------------------------------
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6
ctrl - 7 : yabai -m space --focus 7
ctrl - 8 : yabai -m space --focus 8
ctrl - 9 : yabai -m space --focus 9

# ------------------------------------------------------------------------------
# Resize window (by edge)
# ------------------------------------------------------------------------------
ctrl + alt - h : yabai -m window --resize left:-30:0
ctrl + alt - j : yabai -m window --resize bottom:0:30
ctrl + alt - k : yabai -m window --resize top:0:-30
ctrl + alt - l : yabai -m window --resize right:30:0

# Alternative resize (increase)
shift + alt - a : yabai -m window --resize left:-20:0
shift + alt - s : yabai -m window --resize bottom:0:20
shift + alt - w : yabai -m window --resize top:0:-20
shift + alt - d : yabai -m window --resize right:20:0

# Alternative resize (decrease)
shift + cmd - a : yabai -m window --resize left:20:0
shift + cmd - s : yabai -m window --resize bottom:0:-20
shift + cmd - w : yabai -m window --resize top:0:20
shift + cmd - d : yabai -m window --resize right:-20:0

# ------------------------------------------------------------------------------
# Move floating window
# ------------------------------------------------------------------------------
shift + ctrl - a : yabai -m window --move rel:-20:0
shift + ctrl - s : yabai -m window --move rel:0:20
shift + ctrl - w : yabai -m window --move rel:0:-20
shift + ctrl - d : yabai -m window --move rel:20:0

# ------------------------------------------------------------------------------
# Insertion point (where new window will split)
# ------------------------------------------------------------------------------
shift + ctrl + alt - h : yabai -m window --insert west
shift + ctrl + alt - j : yabai -m window --insert south
shift + ctrl + alt - k : yabai -m window --insert north
shift + ctrl + alt - l : yabai -m window --insert east

# ------------------------------------------------------------------------------
# Layout
# ------------------------------------------------------------------------------
shift + alt - z : yabai -m space --layout bsp
shift + alt - x : yabai -m space --layout float
shift + alt - s : yabai -m space --layout stack
shift + alt - 0 : yabai -m space --balance

# Toggle split orientation
alt - e : yabai -m window --toggle split

# Mirror layout
alt - m : yabai -m space --mirror x-axis

# ------------------------------------------------------------------------------
# Window toggles
# ------------------------------------------------------------------------------
# Float / unfloat
shift + alt - space : yabai -m window --toggle float

# Float and center
shift + alt - c : yabai -m window --toggle float --grid 8:6:1:1:4:6

# Sticky + picture-in-picture
ctrl + alt - p : yabai -m window --toggle sticky --toggle pip

# Zoom (parent container / fullscreen)
alt - d : yabai -m window --toggle zoom-parent
alt - f : yabai -m window --toggle zoom-fullscreen

# Native fullscreen (macOS fullscreen space)
# [FIXED: was 'native-toggle' which is not a valid yabai property]
shift + alt - f : yabai -m window --toggle native-fullscreen

# ------------------------------------------------------------------------------
# Floating window grids
# ------------------------------------------------------------------------------
# Fill screen
shift + alt - up : yabai -m window --toggle float --grid 1:1:0:0:1:1

# Left third
shift + alt - left : yabai -m window --toggle float --grid 1:3:0:0:1:1

# Right third
shift + alt - right : yabai -m window --toggle float --grid 1:3:2:0:1:1

# Center third
shift + alt - down : yabai -m window --toggle float --grid 1:3:1:0:1:1

# ------------------------------------------------------------------------------
# Display (multi-monitor)
# ------------------------------------------------------------------------------
# Focus display
ctrl + alt - z : yabai -m display --focus recent

# Send window to display and follow
ctrl + cmd - c : yabai -m window --display next; yabai -m display --focus next

# ------------------------------------------------------------------------------
# Layout save/restore (per space)
# ------------------------------------------------------------------------------
# Save current window layout to /tmp/yabai_layout_<space>.json
ctrl + alt - s : /Users/carakan/.dotfiles/config/yabai/save_layout.sh

# Restore saved window layout
ctrl + alt - r : /Users/carakan/.dotfiles/config/yabai/restore_layout.sh
