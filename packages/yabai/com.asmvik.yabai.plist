<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.asmvik.yabai.plist — starts the yabai daemon at login.

  yabai is Christian-SC26/yabai (a fork of asmvik/yabai); the binary is the
  v7.3.5 release asset, sha256
  f25c6b50a9a71736403bf0051b2f23e70ff36ecfcfee92193fb5f5cd98d94927.
  Nothing in Homebrew owns it (brew's yabai tap only has 7.1.25), so this
  agent is the only thing that makes the window manager come up — losing it
  means starting yabai by hand after every login.

  The job launches Yabai.app (a bundle in this repo) rather than
  /usr/local/bin/yabai directly: macOS names the Login Items row after the
  launched executable, so the bundle is what makes it read "Yabai" instead of
  "yabai", with the icon and the signer's developer name. The bundle's
  executable is a symlink to /usr/local/bin/yabai — the same path the
  sudoers rule pins for the load-sa call.

  Notes:
  * PATH is a short static list: LaunchAgents inherit a bare PATH and
    yabairc calls jq, yabai and the helper scripts in ~/bin and /usr/local/bin.
  * Logs live in ~/.local/state/yabai/, not /tmp: /tmp is wiped on reboot,
    which erased the evidence of what happened at login.
  * Nice -20 / ProcessType Interactive keep yabai responsive while the
    machine is busy after login.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asmvik.yabai</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/carakan/.dotfiles/packages/yabai/Yabai.app/Contents/MacOS/Yabai</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/Users/carakan/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on ANY exit, not only on a crash. At login yabai can lose a
         startup lock race and exit 0, and `KeepAlive {Crashed}` then left the
         window manager dead until a manual kickstart. ThrottleInterval keeps
         a crash loop from spinning. (v7.3.5) -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>Nice</key>
    <integer>-20</integer>
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/carakan/.local/state/yabai/yabai.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/carakan/.local/state/yabai/yabai.err.log</string>
</dict>
</plist>