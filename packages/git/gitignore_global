# ~/.gitignore_global — applies to every repo (core.excludesFile)
# Keep entries unordered-by-precedence: last match wins in git, but for
# exclusions-only files ordering rarely matters. Grouped for readability.

# ── macOS ────────────────────────────────────────────────
.DS_Store
*.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
.iCloud*

# ── editors / IDEs ───────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.history/
*.swp
*.swo
*~
.fleet/

# ── vim / neovim ─────────────────────────────────────────
*.swo
.nvimlog
.netrwhist
vim/undle/

# ── tags / code indexers ─────────────────────────────────
tags
.tag*
GPATH
GRTAGS
GTAGS
.solargraph.yml
.solargraph/

# ── ruby ─────────────────────────────────────────────────
.byebug_history
.rspec_status
/*.gem
/.bundle/
coverage/
pkg/
gems/*

# ── elixir / erlang ──────────────────────────────────────
.elixir_ls/
/deps/
/_build/
erl_crash.dump
*.ez

# ── node / bun ───────────────────────────────────────────
node_modules/*
.npm/
.yarn/*
!.yarn/patches
!.yarn/releases
*.tsbuildinfo
.eslintcache

# ── crystal ──────────────────────────────────────────────
/lib/
.shards/
crystal-*

# ── env & secrets (never leak by accident) ───────────────
.env
.env.*
!.env.example
.envrc

# ── tooling state ────────────────────────────────────────
.tool-versions
.capistrano/*
tmp/
*.log
.cache/

# -- IA garbage ────────────────────────────────────────────
.atl/