[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  unstage = reset HEAD --
  last = log -1 HEAD
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  fco = !git branch | fzf +m | awk '{print $1}' | xargs git checkout
[user]

[core]
  editor = /usr/local/bin/nvim
  excludesfile = ~/.gitignore_global
  pager = delta
[commit]
  gpgsign = true
[pull]
	rebase = true
[rebase]
	autoStash = true
  updateRefs = true
[color]
  ui = auto
[fetch]
  prune = true
[interactive]
  diffFilter = delta --color-only
[delta]
  features = collared-trogon custom-dark
  navigate = true  # use n and N to move between diff sections
  light = false    # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
  line-numbers = true
[delta "custom-dark"]
  # custom theme layer on top of collared-trogon (see ~/.config/delta/themes.gitconfig)
  file-style = bold "#e5ca81"
  hunk-header-style = file line-number syntax
  hunk-header-decoration-style = none
  line-numbers-left-style = dim "#5b6078"
  line-numbers-right-style = "#5b6078"
  line-numbers-minus-style = bold "#9e5757"
  line-numbers-plus-style = bold "#799e57"
[include]
  path = ~/.config/delta/themes.gitconfig
[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default
  context = 1
[stash]
  showStat = true
  showPatch = true
[init]
	defaultBranch = main
